<Application
    x:Class="Nexsteaduser.CulvertProxy.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="CardFillBrush" Color="#12FFFFFF" />
                    <SolidColorBrush x:Key="CardStrokeBrush" Color="#1FFFFFFF" />
                    <SolidColorBrush x:Key="SubtleTextBrush" Color="#A8FFFFFF" />
                    <SolidColorBrush x:Key="AccentBrush" Color="#FF2DD4BF" />
                    <SolidColorBrush x:Key="AccentOnBrush" Color="#FF062A2A" />
                    <SolidColorBrush x:Key="UpBrush" Color="#FF2DD4BF" />
                    <SolidColorBrush x:Key="DownBrush" Color="#FF60A5FA" />
                    <SolidColorBrush x:Key="GoodBrush" Color="#FF34D399" />
                    <SolidColorBrush x:Key="WarnBrush" Color="#FFFBBF24" />
                    <SolidColorBrush x:Key="BadBrush" Color="#FFF87171" />
                    <SolidColorBrush x:Key="HeroFillBrush" Color="#FF0F172A" />
                    <LinearGradientBrush x:Key="HeroGradientBrush" StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#332DD4BF" Offset="0" />
                        <GradientStop Color="#143B82F6" Offset="1" />
                    </LinearGradientBrush>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="CardFillBrush" Color="#B8FFFFFF" />
                    <SolidColorBrush x:Key="CardStrokeBrush" Color="#16000000" />
                    <SolidColorBrush x:Key="SubtleTextBrush" Color="#70000000" />
                    <SolidColorBrush x:Key="AccentBrush" Color="#FF0D9488" />
                    <SolidColorBrush x:Key="AccentOnBrush" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="UpBrush" Color="#FF0D9488" />
                    <SolidColorBrush x:Key="DownBrush" Color="#FF2563EB" />
                    <SolidColorBrush x:Key="GoodBrush" Color="#FF059669" />
                    <SolidColorBrush x:Key="WarnBrush" Color="#FFD97706" />
                    <SolidColorBrush x:Key="BadBrush" Color="#FFDC2626" />
                    <SolidColorBrush x:Key="HeroFillBrush" Color="#FFF1F5F9" />
                    <LinearGradientBrush x:Key="HeroGradientBrush" StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#220D9488" Offset="0" />
                        <GradientStop Color="#102563EB" Offset="1" />
                    </LinearGradientBrush>
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="CardFillBrush" Color="#FF000000" />
                    <SolidColorBrush x:Key="CardStrokeBrush" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="SubtleTextBrush" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="AccentBrush" Color="#FFFFFF00" />
                    <SolidColorBrush x:Key="AccentOnBrush" Color="#FF000000" />
                    <SolidColorBrush x:Key="UpBrush" Color="#FF00FF00" />
                    <SolidColorBrush x:Key="DownBrush" Color="#FF00FFFF" />
                    <SolidColorBrush x:Key="GoodBrush" Color="#FF00FF00" />
                    <SolidColorBrush x:Key="WarnBrush" Color="#FFFFFF00" />
                    <SolidColorBrush x:Key="BadBrush" Color="#FFFF0000" />
                    <SolidColorBrush x:Key="HeroFillBrush" Color="#FF000000" />
                    <LinearGradientBrush x:Key="HeroGradientBrush" StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#FF000000" Offset="0" />
                        <GradientStop Color="#FF000000" Offset="1" />
                    </LinearGradientBrush>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <Style x:Key="Card" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardFillBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="14" />
                <Setter Property="Padding" Value="18" />
            </Style>
            <Style x:Key="PageTitle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="26" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            </Style>
            <Style x:Key="SectionTitle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="15" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
            <Style x:Key="Subtle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{ThemeResource SubtleTextBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style x:Key="MetricValue" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Consolas" />
                <Setter Property="FontSize" Value="25" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="IsTextSelectionEnabled" Value="True" />
            </Style>
            <Style x:Key="Mono" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Consolas" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="IsTextSelectionEnabled" Value="True" />
            </Style>
            <Style x:Key="Badge" TargetType="Border">
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="Padding" Value="7,2" />
                <Setter Property="Background" Value="{ThemeResource CardStrokeBrush}" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
