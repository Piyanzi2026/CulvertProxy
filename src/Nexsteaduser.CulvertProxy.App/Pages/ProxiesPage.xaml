<Page
    x:Class="Nexsteaduser.CulvertProxy.App.Pages.ProxiesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Nexsteaduser.CulvertProxy.App.Pages">
    <ScrollViewer Padding="24,8,24,24">
        <StackPanel Spacing="16">
            <Grid>
                <StackPanel Spacing="2">
                    <TextBlock Text="代理服务器" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="管理上游、多跳链路与出口策略。延迟优先会按握手耗时为每条链路排序。" Style="{StaticResource Subtle}" />
                </StackPanel>
                <Button
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Content="添加服务器"
                    Click="AddEndpoint_Click"
                    Style="{StaticResource AccentButtonStyle}"
                    Padding="16,7" />
            </Grid>

            <InfoBar x:Name="StatusBar" IsOpen="False" IsClosable="True" />

            <Border Style="{StaticResource Card}">
                <StackPanel Spacing="10">
                    <Grid>
                        <TextBlock Text="服务器" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="测试目标 1.1.1.1:443" Style="{StaticResource Subtle}" HorizontalAlignment="Right" />
                    </Grid>
                    <ListView x:Name="EndpointList" ItemsSource="{x:Bind Endpoints}" SelectionMode="None" IsItemClickEnabled="False">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:EndpointRow">
                                <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,0,8">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Style="{StaticResource Badge}" VerticalAlignment="Top" Margin="0,2,0,0">
                                            <TextBlock Text="{x:Bind Protocol}" FontSize="11" FontWeight="SemiBold" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Spacing="2">
                                            <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" FontSize="14" />
                                            <TextBlock Text="{x:Bind Endpoint}" Style="{StaticResource Mono}" />
                                            <TextBlock Text="{x:Bind Detail}" Style="{StaticResource Subtle}" />
                                            <TextBlock
                                                Text="{x:Bind TestResult, Mode=OneWay}"
                                                Foreground="{ThemeResource AccentBrush}"
                                                Style="{StaticResource Subtle}"
                                                Visibility="{x:Bind TestVisibility, Mode=OneWay}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <CheckBox
                                                Content="启用"
                                                IsChecked="{x:Bind Enabled}"
                                                Click="EndpointEnabled_Click"
                                                VerticalAlignment="Center" />
                                            <Button Content="{x:Bind TestButtonText, Mode=OneWay}" Click="TestEndpoint_Click" IsEnabled="{x:Bind IsNotTesting, Mode=OneWay}" />
                                            <Button Content="编辑" Click="EditEndpoint_Click" />
                                            <Button Content="删除" Click="DeleteEndpoint_Click" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock x:Name="EmptyEndpoints" Text="还没有服务器。添加一个 SOCKS5 或 HTTP CONNECT 上游即可开始。" Style="{StaticResource Subtle}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel Spacing="10">
                    <Grid>
                        <TextBlock Text="策略与链路" Style="{StaticResource SectionTitle}" />
                        <Button
                            HorizontalAlignment="Right"
                            Content="新建策略"
                            Click="AddPolicy_Click"
                            Padding="12,5" />
                    </Grid>
                    <ListView x:Name="PolicyList" ItemsSource="{x:Bind Policies}" SelectionMode="None">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:PolicyRow">
                                <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,0,8">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="3">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" FontSize="14" />
                                                <Border Style="{StaticResource Badge}" Visibility="{x:Bind DefaultVisibility}" Background="{ThemeResource AccentBrush}">
                                                    <TextBlock Text="默认" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource AccentOnBrush}" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{x:Bind ModeText}" Style="{StaticResource Subtle}" />
                                            <TextBlock Text="{x:Bind ChainsText}" Style="{StaticResource Mono}" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <CheckBox Content="启用" IsChecked="{x:Bind Enabled}" Click="PolicyEnabled_Click" />
                                            <Button Content="设为默认" Click="SetDefaultPolicy_Click" IsEnabled="{x:Bind IsNotDefault}" />
                                            <Button Content="编辑" Click="EditPolicy_Click" />
                                            <Button Content="删除" Click="DeletePolicy_Click" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock x:Name="EmptyPolicies" Text="没有策略。规则需要引用策略才能把流量送入上游。" Style="{StaticResource Subtle}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
