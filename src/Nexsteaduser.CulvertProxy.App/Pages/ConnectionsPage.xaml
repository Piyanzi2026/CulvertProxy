<Page
    x:Class="Nexsteaduser.CulvertProxy.App.Pages.ConnectionsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Nexsteaduser.CulvertProxy.App.Pages">
    <Grid Padding="24,8,24,24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Spacing="2">
            <TextBlock Text="连接" Style="{StaticResource PageTitle}" />
            <TextBlock Text="活动连接与最近历史。断开操作会立即取消对应会话。" Style="{StaticResource Subtle}" />
        </StackPanel>

        <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ToggleSwitch x:Name="ActiveOnlyToggle" Header="仅活动" IsOn="True" Toggled="Filter_Changed" OnContent="是" OffContent="否" />
            <TextBox Grid.Column="1" x:Name="FilterBox" PlaceholderText="搜索目标、进程或规则" TextChanged="Filter_TextChanged" VerticalAlignment="Bottom" />
            <TextBlock Grid.Column="2" x:Name="SummaryText" VerticalAlignment="Bottom" Margin="0,0,0,8" Style="{StaticResource Subtle}" />
            <Button Grid.Column="3" Content="立即刷新" Click="Refresh_Click" VerticalAlignment="Bottom" />
        </Grid>

        <TextBlock Grid.Row="2" x:Name="EmptyText" Text="暂无连接。启动代理后，经过本地入口的流量会实时出现在这里。" Style="{StaticResource Subtle}" />

        <ListView Grid.Row="3" x:Name="ConnectionList" ItemsSource="{x:Bind Items}" SelectionMode="None">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:ConnectionRow">
                    <Border Style="{StaticResource Card}" Padding="12" Margin="0,0,0,6">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="3">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{x:Bind Target}" Style="{StaticResource Mono}" FontSize="13" FontWeight="SemiBold" />
                                    <Border Style="{StaticResource Badge}">
                                        <TextBlock Text="{x:Bind Protocol}" FontSize="10" />
                                    </Border>
                                    <TextBlock Text="{x:Bind StateText, Mode=OneWay}" Foreground="{x:Bind StateBrush, Mode=OneWay}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Text="{x:Bind MetaText, Mode=OneWay}" Style="{StaticResource Subtle}" TextTrimming="CharacterEllipsis" MaxLines="1" />
                                <StackPanel Orientation="Horizontal" Spacing="14">
                                    <TextBlock Text="{x:Bind TrafficText, Mode=OneWay}" Style="{StaticResource Mono}" />
                                    <TextBlock Text="{x:Bind DurationText, Mode=OneWay}" Style="{StaticResource Mono}" />
                                </StackPanel>
                            </StackPanel>
                            <Button
                                Grid.Column="1"
                                Content="断开"
                                Click="Kill_Click"
                                IsEnabled="{x:Bind IsActive, Mode=OneWay}"
                                VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
