<Page
    x:Class="Nexsteaduser.CulvertProxy.App.Pages.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Nexsteaduser.CulvertProxy.App.Controls"
    xmlns:local="using:Nexsteaduser.CulvertProxy.App.Pages">
    <ScrollViewer Padding="24,8,24,24">
        <StackPanel Spacing="16">
            <Border Background="{ThemeResource HeroGradientBrush}" Style="{StaticResource Card}" Padding="24">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Ellipse Width="10" Height="10" VerticalAlignment="Center" Fill="{x:Bind ViewModel.StatusBrush, Mode=OneWay}" />
                            <TextBlock Text="本地代理" Style="{StaticResource Subtle}" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="{x:Bind ViewModel.StatusHeadline, Mode=OneWay}" FontSize="30" FontWeight="SemiBold" />
                        <TextBlock Text="{x:Bind ViewModel.StatusDetail, Mode=OneWay}" Style="{StaticResource Subtle}" MaxWidth="620" />
                        <TextBlock Text="{x:Bind ViewModel.ListenText, Mode=OneWay}" Style="{StaticResource Mono}" Margin="0,4,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="12" MinWidth="220">
                        <ToggleSwitch
                            x:Name="SystemProxyToggle"
                            Header="系统代理 (PAC)"
                            IsOn="{x:Bind ViewModel.SystemProxyEnabled, Mode=OneWay}"
                            OnContent="已启用"
                            OffContent="未启用"
                            Toggled="SystemProxy_Toggled" />
                        <Button
                            Content="{x:Bind ViewModel.ToggleLabel, Mode=OneWay}"
                            Click="Toggle_Click"
                            Style="{StaticResource AccentButtonStyle}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            Padding="18,9" />
                    </StackPanel>
                </Grid>
            </Border>

            <InfoBar
                IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                Message="{x:Bind ViewModel.ErrorText, Mode=OneWay}"
                Severity="Error"
                IsClosable="False" />

            <Grid ColumnSpacing="12" RowSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}">
                    <StackPanel Spacing="4">
                        <TextBlock Text="活动连接" Style="{StaticResource Subtle}" />
                        <TextBlock Text="{x:Bind ViewModel.ActiveText, Mode=OneWay}" Style="{StaticResource MetricValue}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource Card}">
                    <StackPanel Spacing="4">
                        <TextBlock Text="上行速率" Style="{StaticResource Subtle}" />
                        <TextBlock Text="{x:Bind ViewModel.UpText, Mode=OneWay}" Style="{StaticResource MetricValue}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel Spacing="4">
                        <TextBlock Text="下行速率" Style="{StaticResource Subtle}" />
                        <TextBlock Text="{x:Bind ViewModel.DownText, Mode=OneWay}" Style="{StaticResource MetricValue}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="3" Style="{StaticResource Card}">
                    <StackPanel Spacing="4">
                        <TextBlock Text="累计流量" Style="{StaticResource Subtle}" />
                        <TextBlock Text="{x:Bind ViewModel.TotalText, Mode=OneWay}" Style="{StaticResource MetricValue}" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <TextBlock Text="实时吞吐" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="最近 120 秒" Style="{StaticResource Subtle}" HorizontalAlignment="Right" />
                    </Grid>
                    <controls:TrafficChart x:Name="Chart" Grid.Row="1" Height="190" Margin="0,12,0,0" />
                </Grid>
            </Border>

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="上游健康度" Style="{StaticResource SectionTitle}" />
                        <ListView
                            Grid.Row="1"
                            ItemsSource="{x:Bind ViewModel.Health}"
                            SelectionMode="None"
                            MaxHeight="220"
                            Margin="0,8,0,0">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="local:HealthRow">
                                    <Grid Padding="0,6" ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Ellipse Width="8" Height="8" Fill="{x:Bind DotBrush}" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" Spacing="1">
                                            <TextBlock Text="{x:Bind Name}" />
                                            <TextBlock Text="{x:Bind Error}" Style="{StaticResource Subtle}" TextTrimming="CharacterEllipsis" MaxLines="1" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                                            <TextBlock Text="{x:Bind Latency}" Style="{StaticResource Mono}" HorizontalAlignment="Right" />
                                            <TextBlock Text="{x:Bind Status}" Style="{StaticResource Subtle}" HorizontalAlignment="Right" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource Card}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="运行信息" Style="{StaticResource SectionTitle}" />
                        <Grid ColumnSpacing="12" RowSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="运行时长" Style="{StaticResource Subtle}" />
                            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.UptimeText, Mode=OneWay}" Style="{StaticResource Mono}" HorizontalAlignment="Right" />
                            <TextBlock Grid.Row="1" Text="DNS 服务" Style="{StaticResource Subtle}" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind ViewModel.DnsText, Mode=OneWay}" Style="{StaticResource Mono}" HorizontalAlignment="Right" />
                            <TextBlock Grid.Row="2" Text="透明接管" Style="{StaticResource Subtle}" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{x:Bind ViewModel.InterceptText, Mode=OneWay}" Style="{StaticResource Mono}" HorizontalAlignment="Right" />
                            <TextBlock Grid.Row="3" Text="入口协议" Style="{StaticResource Subtle}" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="SOCKS5 / HTTP" Style="{StaticResource Mono}" HorizontalAlignment="Right" />
                        </Grid>
                        <Border Height="1" Background="{ThemeResource CardStrokeBrush}" />
                        <TextBlock Text="把本地入口填入客户端，或开启系统代理让浏览器与 WinINET 应用自动使用 PAC。" Style="{StaticResource Subtle}" />
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
