<Page
    x:Class="Nexsteaduser.CulvertProxy.App.Pages.RulesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Nexsteaduser.CulvertProxy.App.Pages">
    <ScrollViewer Padding="24,8,24,24">
        <StackPanel Spacing="16">
            <Grid>
                <StackPanel Spacing="2">
                    <TextBlock Text="路由规则" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="按顺序匹配进程、域名、IP 段与端口。进程归属来自本地连接表，代理流量可精确到发起程序。" Style="{StaticResource Subtle}" />
                </StackPanel>
                <Button
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Content="添加规则"
                    Click="AddRule_Click"
                    Style="{StaticResource AccentButtonStyle}"
                    Padding="16,7" />
            </Grid>

            <InfoBar x:Name="StatusBar" IsOpen="False" IsClosable="True" />

            <Border Style="{StaticResource Card}">
                <StackPanel Spacing="10">
                    <Grid>
                        <TextBlock Text="规则列表" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="首条命中生效" Style="{StaticResource Subtle}" HorizontalAlignment="Right" />
                    </Grid>
                    <ListView x:Name="RuleList" ItemsSource="{x:Bind Rules}" SelectionMode="None">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:RuleRow">
                                <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,0,8">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="3">
                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" FontSize="14" />
                                                <TextBlock Text="{x:Bind ActionText}" FontWeight="SemiBold" Foreground="{x:Bind ActionBrush}" />
                                            </StackPanel>
                                            <TextBlock Text="{x:Bind ConditionText}" Style="{StaticResource Subtle}" />
                                            <TextBlock Text="{x:Bind PolicyText}" Style="{StaticResource Mono}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                            <CheckBox Content="启用" IsChecked="{x:Bind Enabled}" Click="RuleEnabled_Click" />
                                            <Button Content="↑" Click="MoveUp_Click" IsEnabled="{x:Bind CanMoveUp}" Padding="8,4" ToolTipService.ToolTip="上移" />
                                            <Button Content="↓" Click="MoveDown_Click" IsEnabled="{x:Bind CanMoveDown}" Padding="8,4" ToolTipService.ToolTip="下移" />
                                            <Button Content="编辑" Click="EditRule_Click" />
                                            <Button Content="删除" Click="DeleteRule_Click" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock x:Name="EmptyRules" Text="还没有规则。未命中的流量会使用默认策略。" Style="{StaticResource Subtle}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel Spacing="6">
                    <TextBlock Text="匹配说明" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="域名规则中的 *.example.com 仅匹配子域；.example.com 同时匹配主域。re: 前缀启用正则，超时自动放弃。IP 段只对已经是 IP 字面量的目标生效，域名不会为了匹配规则而提前解析。" Style="{StaticResource Subtle}" />
                    <TextBlock Text="规则引用策略后，策略内的多跳链路按选择方式排序。代理决策一律失败关闭：策略缺失、全部链路失败或没有可用链路时断开连接，不会静默直连。" Style="{StaticResource Subtle}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
