<ContentDialog
    x:Class="Nexsteaduser.CulvertProxy.App.Dialogs.EndpointDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="上游服务器"
    PrimaryButtonText="保存"
    CloseButtonText="取消"
    DefaultButton="Primary"
    MinWidth="460">
    <ScrollViewer MaxHeight="560">
        <StackPanel Spacing="12">
            <TextBox x:Name="NameBox" Header="名称" PlaceholderText="香港中转" />
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.1*" />
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="0.9*" />
                </Grid.ColumnDefinitions>
                <ComboBox x:Name="ProtocolBox" Header="协议" HorizontalAlignment="Stretch" />
                <TextBox Grid.Column="1" x:Name="HostBox" Header="主机" PlaceholderText="203.0.113.10 或 proxy.example.com" />
                <NumberBox
                    Grid.Column="2"
                    x:Name="PortBox"
                    Header="端口"
                    Minimum="1"
                    Maximum="65535"
                    SmallChange="1"
                    SpinButtonPlacementMode="Compact"
                    Value="1080" />
            </Grid>
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="UsernameBox" Header="用户名（可选）" />
                <PasswordBox Grid.Column="1" x:Name="PasswordBox" Header="密码（可选）" />
            </Grid>
            <CheckBox x:Name="ClearPasswordBox" Content="清除已保存的密码" Visibility="Collapsed" />
            <CheckBox x:Name="TlsBox" Content="使用 TLS 包装（SNI 伪装到 443）" />
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="SniBox" Header="TLS SNI（可选）" PlaceholderText="cdn.example.com" />
                <CheckBox Grid.Column="1" x:Name="InsecureBox" Content="允许不受信任的证书" VerticalAlignment="Bottom" Margin="0,0,0,6" />
            </Grid>
            <TextBox
                x:Name="PinBox"
                Header="证书 SHA-256 指纹（可选）"
                PlaceholderText="64 位十六进制，可带冒号"
                FontFamily="Consolas" />
            <CheckBox x:Name="EnabledBox" Content="启用该服务器" IsChecked="True" />
            <TextBox x:Name="NoteBox" Header="备注" AcceptsReturn="True" Height="70" TextWrapping="Wrap" />
            <TextBlock x:Name="ErrorText" Foreground="{ThemeResource BadBrush}" TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
